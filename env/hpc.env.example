# Copy this file outside the repository, replace every placeholder, then source it.
export PROJECT_ROOT="$HOME/AstraGuard-LandCover"
export RAW_DIR="/persistent/<username>/datasets/astraguard-landcover/raw"
export PROCESSED_DIR="/persistent/<username>/datasets/astraguard-landcover/processed"
export OUTPUT_DIR="/persistent/<username>/runs/astraguard-landcover"
export PYTHON_BIN="$HOME/.conda/envs/astraguard-landcover/bin/python"
export CACHE_DIR="$HOME/.cache/astraguard-landcover"
export STAGE_DATA=1
