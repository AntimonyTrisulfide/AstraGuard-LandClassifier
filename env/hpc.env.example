# Optional overrides. The two launcher scripts work without sourcing this file.
export DATA_ROOT="/persistent/<username>/astraguard-landcover"
export RAW_DIR="$DATA_ROOT/raw"
export OUTPUT_DIR="$DATA_ROOT/runs"
export PYTHON_BIN="$HOME/.conda/envs/astraguard-landcover/bin/python"
export CACHE_DIR="$HOME/.cache/astraguard-landcover"
export CONFIG="configs/deeplabv3plus.yaml"
export RUN_NAME="deeplabv3plus_v1"
export GPU_QUEUE="dgx"
export DOWNLOAD_QUEUE="long"
export DOWNLOAD_WALLTIME="24:00:00"
